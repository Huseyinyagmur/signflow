<% content_for :title, @version.title %>
<div class="page-heading"><div class="min-w-0"><%= link_to "← Şablonlarım", templates_path, class: "mb-4 inline-block text-sm text-slate-500" %><h1 class="break-words"><%= @version.title %></h1><p class="break-words"><%= @version.description %></p></div><div class="flex flex-wrap gap-2"><%= link_to "Düzenle", edit_template_path(@template), class: "btn btn-secondary" %><%= link_to "Sözleşme oluştur", new_template_document_path(@template, version_id: @version.id), class: "btn btn-primary" %></div></div>
<div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1fr)_320px]"><section class="panel"><div class="panel-heading"><h2 class="font-semibold">Şablon metni</h2><span class="badge badge-draft">v<%= @version.number %></span></div><div class="p-6 md:p-8"><p class="contract-text"><%= @version.content %></p></div></section><aside class="space-y-5"><section class="panel p-6"><h2 class="font-semibold">Sürüm bilgisi</h2><p class="mt-3 text-sm text-slate-500">v<%= @version.number %> · <%= display_time(@version.created_at) %></p><p class="hint"><%= @version.id == @template.current_version_id ? "Güncel sürümü görüntülüyorsunuz." : "Geçmiş bir sürümü görüntülüyorsunuz. Bu metinden de sözleşme oluşturabilirsiniz." %></p><%= link_to "Sürüm geçmişini görüntüle →", history_template_path(@template), class: "mt-5 inline-block text-sm font-semibold text-teal-800" %></section><section class="panel p-6"><h2 class="font-semibold">Doldurulacak alanlar</h2><ul class="mt-4 space-y-3"><% @version.variables.each do |field| %><li class="text-sm text-slate-600"><span class="mr-2 text-teal-700">↗</span><%= Templates::Renderer::FIELDS.fetch(field) %></li><% end %></ul><p class="hint"><%= @version.variables.empty? ? "Bu sürümde değişken alan yok." : "Alanlar sözleşme oluşturma ekranında otomatik hazırlanır." %></p></section></aside></div>
