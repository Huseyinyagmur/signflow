<% if documents.any? %>
<div class="overflow-x-auto"><table class="w-full text-left text-sm"><thead class="border-b border-slate-100 bg-slate-50/60 text-xs text-slate-500"><tr><th class="px-6 py-4 font-medium">Sözleşme</th><th class="px-6 py-4 font-medium">Alıcı</th><th class="px-6 py-4 font-medium">Durum</th><th class="px-6 py-4 font-medium">Son imza tarihi</th><th class="px-6 py-4"><span class="sr-only">Detay</span></th></tr></thead><tbody class="divide-y divide-slate-100">
<% documents.each do |document| %><tr class="hover:bg-slate-50/70"><td class="px-6 py-5"><%= link_to document_path(document), class: "flex items-center gap-3 font-semibold text-slate-800 hover:text-teal-800" do %><span class="hidden rounded-xl border border-slate-200 p-2.5 text-slate-400 sm:inline-flex"><%= sf_icon("file") %></span><span class="max-w-64 break-words"><%= document.title %><span class="mt-1 block text-xs font-normal text-slate-400"><%= document.created_at.strftime("%d.%m.%Y") %> tarihinde oluşturuldu</span></span><% end %></td><td class="px-6 py-5"><p><%= document.recipient_name.presence || "Henüz eklenmedi" %></p><p class="mt-1 text-xs text-slate-400"><%= document.recipient_email %></p></td><td class="px-6 py-5"><%= status_badge(document) %></td><td class="whitespace-nowrap px-6 py-5 text-xs text-slate-500"><%= display_time(document.expires_at) %></td><td class="px-6 py-5"><%= link_to document_path(document), class: "text-slate-400 hover:text-teal-800", aria: { label: "#{document.title} detayları" } do %><%= sf_icon("arrow") %><% end %></td></tr><% end %>
</tbody></table></div>
<% else %>
<div class="px-6 py-16 text-center"><span class="mb-5 inline-flex rounded-2xl bg-teal-50 p-4 text-teal-800"><%= sf_icon("file", css: "h-8 w-8") %></span><h3 class="text-lg font-semibold">Burada yeni bir başlangıç var.</h3><p class="mx-auto mt-2 max-w-sm text-sm leading-6 text-slate-500">Bu görünümde henüz sözleşme yok. İlk taslağınızı oluşturup süreci başlatabilirsiniz.</p><%= link_to "İlk sözleşmenizi oluşturun", new_document_path, class: "btn btn-secondary mt-6" %></div>
<% end %>
