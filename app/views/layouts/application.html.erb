<!DOCTYPE html>
<html lang="tr">
<head>
  <title><%= content_for?(:title) ? "#{yield(:title)} · SignFlow" : "SignFlow · Sözleşmeden imzaya" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="application-name" content="SignFlow">
  <meta name="turbo-cache-control" content="no-cache">
  <%= csrf_meta_tags %><%= csp_meta_tag %>
  <link rel="icon" type="image/svg+xml" href="/signflow.svg">
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body>
<a class="sr-only focus:not-sr-only focus:p-4" href="#main">İçeriğe geç</a>
<% workspace = current_user && %w[dashboard documents].include?(controller_name) %>
<% if workspace %>
  <aside class="workspace-sidebar">
    <%= link_to root_path, class: "brand" do %><span class="brand-mark">S<small>↗</small></span>SignFlow<% end %>
    <p class="eyebrow mt-12 mb-4 hidden lg:block">ÇALIŞMA ALANI</p>
    <nav class="mt-5 flex flex-wrap gap-2 lg:mt-0 lg:flex-col" aria-label="Ana menü">
      <%= link_to dashboard_path, class: "nav-link #{'active' if controller_name == 'dashboard'}" do %><%= sf_icon("grid") %> Genel bakış<% end %>
      <%= link_to documents_path, class: "nav-link #{'active' if controller_name == 'documents'}" do %><%= sf_icon("file") %> Sözleşmelerim<% end %>
      <%= link_to new_document_path, class: "nav-link" do %><%= sf_icon("plus") %> Yeni sözleşme<% end %>
    </nav>
    <div class="mt-auto pt-8 lg:pt-12">
      <div class="hidden rounded-2xl border border-teal-100 bg-teal-50 p-4 text-sm text-teal-900 lg:block"><%= sf_icon("shield", css: "h-6 w-6 mb-3") %><strong>Demo çalışma alanı</strong><p class="mt-2 text-xs leading-5">Sözleşme akışınızı keşfedin. Bu uygulama nitelikli elektronik imza sağlamaz.</p></div>
      <div class="flex items-center gap-3 lg:mt-6 lg:border-t lg:border-slate-100 lg:pt-5"><span class="avatar"><%= current_user.name.first.upcase %></span><div class="min-w-0"><p class="truncate text-sm font-semibold"><%= current_user.name %></p><%= button_to "Çıkış yap", session_path, method: :delete, class: "mt-1 text-xs text-slate-500 hover:text-teal-800" %></div></div>
    </div>
  </aside>
  <div class="workspace-main">
    <header class="workspace-topbar"><span class="text-sm text-slate-500">Çalışma alanım <span class="mx-2 text-slate-300">/</span> <span class="text-slate-800"><%= controller_name == 'dashboard' ? 'Genel bakış' : 'Sözleşmeler' %></span></span><span class="badge badge-draft">Demo sürümü</span></header>
<% else %>
  <header class="public-header">
    <%= link_to root_path, class: "brand" do %><span class="brand-mark">S<small>↗</small></span>SignFlow<% end %>
    <nav class="flex items-center gap-2" aria-label="Üst menü">
      <% if current_user %><%= link_to "Çalışma alanım", dashboard_path, class: "btn btn-primary" %>
      <% else %><%= link_to "Giriş yap", new_session_path, class: "btn btn-plain" %><%= link_to "Hesap oluştur", new_registration_path, class: "btn btn-primary" %><% end %>
    </nav>
  </header>
<% end %>
<main id="main" class="<%= workspace ? 'workspace-content' : 'public-content' %>">
  <% flash.each do |type, message| %><div role="<%= type == 'alert' ? 'alert' : 'status' %>" class="notice <%= type == 'alert' ? 'notice-error' : 'notice-success' %>"><%= message %></div><% end %>
  <%= yield %>
</main>
<% if workspace %></div><% end %>
<footer class="<%= workspace ? 'workspace-footer' : 'public-footer' %>"><span>© <%= Time.current.year %> SignFlow</span><span>Üniversite projesi · Demo elektronik imza</span></footer>
</body>
</html>
