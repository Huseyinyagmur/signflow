# Safe examples only. Copy to .env privately for Rails development; never commit secrets.
# dotenv-rails loads .env only in development; existing process ENV takes precedence.
# Test does not load local secrets. Production uses Render Environment Variables.
# This example file and the standalone Ruby CLI are not auto-loaded.
AGENT_API_ENABLED=false
# Independent session-authenticated web AI feature; disabled until operator setup.
AI_CONTRACTS_ENABLED=false
SIGNFLOW_BASE_URL=http://127.0.0.1:3000
SIGNFLOW_ALLOW_LOOPBACK_HTTP=false
SIGNFLOW_API_TOKEN=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SIGNFLOW_LLM_PROVIDER=anthropic
SIGNFLOW_LLM_MODEL=claude-haiku-4-5-20251001
# For Gemini set the model explicitly, e.g. gemini-3.5-flash-lite after your account checks.
SIGNFLOW_GEMINI_TIER=free
# Confirm only after personally verifying project free tier / billing-off conditions.
SIGNFLOW_GEMINI_FREE_TIER_CONFIRMED=false
SIGNFLOW_TEMPLATE_ID=
SIGNFLOW_TEMPLATE_VERSION_ID=
SIGNFLOW_SYNTHETIC_DATA=false
# Enable only after approving provider billing and sending synthetic data.
SIGNFLOW_ALLOW_PAID_LLM=false
