<% content_for :title, "Şablondan sözleşme oluştur" %>
<div class="page-heading"><div><%= link_to "← Şablonlarım", templates_path, class: "mb-4 inline-block text-sm text-slate-500" %><h1>Alanları doldurun. Sözleşmeniz hazır.</h1><p><%= @version.title %> · v<%= @version.number %></p></div><span class="badge badge-draft">Yeni sözleşme taslağı</span></div>
<% if @render_error %><div class="notice notice-error" role="alert"><%= @render_error %></div><% end %>
<%= render "shared/errors", record: @document %>
<%# Preview and create use different POST actions; the session-bound global token validates both. %>
<%= form_with model: @document, url: template_documents_path(@template), authenticity_token: form_authenticity_token, data: { turbo: false } do |form| %>
<%= hidden_field_tag :version_id, @version.id %>
<div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1fr)_360px]"><div class="space-y-6"><section class="panel"><div class="panel-heading"><h2 class="font-semibold">01 · Değişen bilgileri girin</h2><span class="text-xs text-slate-400"><%= @version.variables.size %> alan</span></div><div class="grid gap-5 p-6 md:grid-cols-2"><% @version.variables.each do |field| %><div><%= label_tag "value_#{field}", Templates::Renderer::FIELDS.fetch(field) %><% if field.end_with?("_tarihi") %><%= date_field_tag "values[#{field}]", @values[field], id: "value_#{field}", required: true %><% else %><%= text_field_tag "values[#{field}]", @values[field], id: "value_#{field}", required: true, maxlength: 5000 %><% end %></div><% end %><% if @version.variables.empty? %><p class="text-sm text-slate-500 md:col-span-2">Bu sürümde doldurulacak değişken yok. Belge bilgilerini kontrol ederek devam edebilirsiniz.</p><% end %></div></section>
<section class="panel" id="template-preview"><div class="panel-heading"><h2 class="font-semibold">02 · Sözleşme önizlemesi</h2><span class="text-xs text-slate-400"><%= @preview_ready ? "Güncel form bilgileriyle hazırlandı" : "Henüz hazırlanmadı" %></span></div><div class="p-6 md:p-8"><% if @preview_ready %><p class="contract-text"><%= @document.content %></p><% else %><p class="text-sm leading-7 text-slate-500">Alanları doldurup “Önizle” düğmesine basın. Metin sunucuda güvenli biçimde hazırlanır. Düzenleme yaptıktan sonra tekrar önizleyebilirsiniz.</p><% end %></div></section></div>
<aside class="space-y-5"><section class="panel p-6"><h2 class="mb-5 font-semibold">Belge ve alıcı bilgileri</h2><div class="field-group"><%= form.label :title, "Sözleşme başlığı" %><%= form.text_field :title, required: true %></div><div class="field-group"><%= form.label :recipient_name, "Alıcının adı soyadı" %><%= form.text_field :recipient_name %><p class="hint">Boş bırakırsanız “Alıcı adı” değişkeninden doldurulur.</p></div><div class="field-group"><%= form.label :recipient_email, "Alıcının e-postası" %><%= form.email_field :recipient_email %></div><div><%= form.label :expires_at, "Son imzalama tarihi" %><%= form.datetime_local_field :expires_at, step: 60 %><p class="hint">Türkiye saati (UTC+3). Alıcı bilgilerini taslakta da tamamlayabilirsiniz.</p></div></section>
<%= form.button "Önizle", type: :submit, formaction: preview_template_documents_path(@template), class: "btn btn-secondary w-full" %>
<%= form.submit "Sözleşme taslağını oluştur", class: "btn btn-primary w-full" %>
<p class="hint">Kaydetme sırasında metin tekrar sunucuda hazırlanır. Şablon daha sonra güncellense bile bu sözleşme değişmez.</p></aside></div>
<% end %>
