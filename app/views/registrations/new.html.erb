<% content_for :title, "Hesap oluştur" %>
<div class="mx-auto max-w-md py-10">
<div class="mb-8 text-center"><h1 class="text-3xl font-semibold">İlk adımı atın.</h1><p class="mt-3 text-sm text-slate-500">Sözleşmeleriniz için yeni bir çalışma alanı.</p></div>
<div class="panel p-7"><%= render "shared/errors", record: @user %><%= form_with model: @user, url: registration_path do |form| %>
  <div class="field-group"><%= form.label :name, "Ad soyad" %><%= form.text_field :name, required: true, autocomplete: "name" %></div>
  <div class="field-group"><%= form.label :email, "E-posta adresi" %><%= form.email_field :email, required: true, autocomplete: "username", placeholder: "siz@ornek.com" %></div>
  <div class="field-group"><%= form.label :password, "Parola" %><%= form.password_field :password, required: true, minlength: 12, maxlength: 72, autocomplete: "new-password" %><p class="hint">En az 12 karakter kullanın.</p></div>
  <div class="field-group"><%= form.label :password_confirmation, "Parola tekrarı" %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %></div>
  <%= form.submit "Hesap oluştur", class: "btn btn-primary w-full" %>
<% end %></div>
<p class="mt-6 text-center text-sm text-slate-500">Zaten hesabınız var mı? <%= link_to "Giriş yapın", new_session_path, class: "font-semibold text-teal-800" %></p>
</div>
