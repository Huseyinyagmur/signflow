<% content_for :title, "Şablonlarım" %>
<div class="page-heading"><div><p class="eyebrow mb-3">TEKRAR YAZMAYIN, BİR KEZ HAZIRLAYIN</p><h1>Şablonlarım</h1><p>Ortak metinleri merkezde tutun. Her sözleşmede yalnızca değişen alanları doldurun.</p></div><%= link_to new_template_path, class: "btn btn-primary" do %><%= sf_icon("plus") %> Yeni şablon<% end %></div>
<div class="mb-7 flex flex-wrap items-center justify-between gap-4">
<%= form_with url: templates_path, method: :get, class: "flex w-full max-w-lg gap-2" do |form| %><%= form.search_field :q, value: params[:q], placeholder: "Başlık veya açıklamada ara…", aria: { label: "Şablon ara" } %><%= form.submit "Ara", class: "btn btn-secondary" %><% end %>
<%= button_to "Demo şablonları ekle", add_examples_templates_path, class: "btn btn-secondary" %>
</div>
<% if @templates.any? %>
<div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3"><% @templates.each do |template| %><article class="panel flex flex-col p-6"><div class="mb-5 flex items-center justify-between"><span class="rounded-xl bg-teal-50 p-3 text-teal-800"><%= sf_icon("file") %></span><span class="badge badge-draft">v<%= template.current_version.number %></span></div><h2 class="break-words text-lg font-semibold"><%= link_to template.title, template_path(template), class: "hover:text-teal-800" %></h2><p class="mt-3 flex-1 break-words text-sm leading-6 text-slate-500"><%= template.description.presence || "Açıklama eklenmedi." %></p><p class="hint mt-5"><%= template.current_version.variables.size %> değişken alan · <%= display_time(template.updated_at) %></p><div class="mt-5 flex flex-wrap gap-2 border-t border-slate-100 pt-5"><%= link_to "Sözleşme oluştur", new_template_document_path(template), class: "btn btn-primary" %><%= link_to "Detay", template_path(template), class: "btn btn-plain" %></div></article><% end %></div>
<% else %><section class="panel p-12 text-center"><span class="mb-5 inline-flex rounded-2xl bg-teal-50 p-4 text-teal-800"><%= sf_icon("grid", css: "h-8 w-8") %></span><h2 class="text-xl font-semibold"><%= params[:q].present? ? "Aramanızla eşleşen şablon yok." : "Bir sonraki sözleşmeniz hazır başlayabilir." %></h2><p class="mx-auto mt-3 max-w-md text-sm leading-7 text-slate-500">Kendi şablonunuzu yazın veya üç ders demosunu ekleyin. Örnekleri tekrar eklemek mevcut metinlerinizi değiştirmez.</p><div class="mt-6 flex flex-wrap justify-center gap-3"><%= link_to "Yeni şablon oluştur", new_template_path, class: "btn btn-primary" %><%= link_to "Tüm şablonlar", templates_path, class: "btn btn-secondary" if params[:q].present? %></div></section><% end %>
