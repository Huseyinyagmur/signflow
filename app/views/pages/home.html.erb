<section class="grid items-center gap-12 py-12 lg:grid-cols-2 lg:gap-20 lg:py-24">
<div>
  <span class="inline-flex items-center gap-2 rounded-full border border-teal-200 bg-teal-50 px-4 py-2 text-xs font-semibold text-teal-800"><span class="h-2 w-2 rounded-full bg-teal-600"></span> Daha akıcı bir sözleşme deneyimi</span>
  <h1 class="mt-7 text-5xl font-semibold leading-[1.12] tracking-tight text-slate-900 md:text-6xl">Sözleşmeden imzaya.<br><span class="text-teal-800">Tek bir akışta.</span></h1>
  <p class="mt-6 max-w-lg text-lg leading-8 text-slate-500">Sözleşmenizi oluşturun, bağlantısını paylaşın ve imza durumunu takip edin. Tüm süreç, düzenli bir çalışma alanında.</p>
  <div class="mt-8 flex flex-wrap gap-3"><%= link_to new_registration_path, class: "btn btn-primary" do %>Ücretsiz başlayın <%= sf_icon("arrow") %><% end %><%= link_to "Hesabınıza giriş yapın", new_session_path, class: "btn btn-secondary" %></div>
  <p class="mt-5 text-xs text-slate-500">Üniversite projesi · Ücret veya kredi kartı gerekmez</p>
</div>
<div class="relative rounded-[2rem] border border-teal-100 bg-[#eaf3ef] p-6 md:p-10">
  <div class="panel rotate-[-2deg] p-6 md:p-8">
    <div class="flex items-center justify-between"><span class="flex items-center gap-2 text-sm font-semibold"><%= sf_icon("file") %> Sözleşme akışı</span><span class="badge badge-signed">Demo</span></div>
    <div class="mt-8 border-b border-slate-100 pb-6"><p class="eyebrow">ÖRNEK SÖZLEŞME</p><h2 class="mt-3 text-xl font-semibold">Birlikte çalışmanın ilk adımı</h2><div class="mt-5 space-y-2"><div class="h-2 w-full rounded bg-slate-100"></div><div class="h-2 w-5/6 rounded bg-slate-100"></div><div class="h-2 w-4/6 rounded bg-slate-100"></div></div></div>
    <div class="mt-6 space-y-5"><% [["1", "Oluşturun", "Sözleşmenin koşullarını belirleyin."], ["2", "Paylaşın", "Bağlantıyı alıcınıza iletin."], ["3", "Tamamlayın", "Demo imzayı ve durumunu takip edin."]].each do |number, title, text| %><div class="flex gap-4"><span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-teal-50 text-sm font-semibold text-teal-800"><%= number %></span><div><p class="text-sm font-semibold"><%= title %></p><p class="mt-1 text-xs text-slate-500"><%= text %></p></div></div><% end %></div>
  </div>
  <div class="absolute -bottom-5 right-4 flex items-center gap-3 rounded-2xl bg-white px-5 py-4 shadow-lg shadow-teal-900/5"><span class="rounded-full bg-teal-50 p-2 text-teal-700"><%= sf_icon("check") %></span><div><p class="text-sm font-semibold">Her adım görünür.</p><p class="mt-1 text-xs text-slate-500">Taslak, bekleyen ve tamamlanan belgeler.</p></div></div>
</div>
</section>
<section class="mb-12 mt-12 grid gap-6 md:grid-cols-3"><% [["pen", "Size ait sözleşmeler", "Başlık, metin ve alıcı bilgilerini tek bir yerden yönetin."], ["shield", "Belgeye özel erişim", "Her sözleşme için ayrı, rastgele bir imzalama bağlantısı."], ["clock", "Net bir zaman çizelgesi", "Son imza tarihini belirleyin, durumunu takip edin."]].each do |icon, title, text| %><div class="panel p-6"><span class="mb-5 inline-flex rounded-xl bg-teal-50 p-3 text-teal-800"><%= sf_icon(icon) %></span><h2 class="text-base font-semibold"><%= title %></h2><p class="mt-2 text-sm leading-6 text-slate-500"><%= text %></p></div><% end %></section>
