# Machine-specific Bundler configuration and credentials.
/.bundle/
/.env
/.env.*
!/.env.example
/config/master.key
/config/credentials/*.key

# Local runtime data; keep Rails directory placeholders.
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/storage/*
!/storage/.keep
/db/*.sqlite3*
/public/assets/
/app/assets/builds/*
!/app/assets/builds/.keep
/coverage/
/node_modules/
