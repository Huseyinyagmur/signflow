<% content_for :title, "Şablon sürüm geçmişi" %>
<div class="page-heading"><div><%= link_to "← Şablon detayları", template_path(@template), class: "mb-4 inline-block text-sm text-slate-500" %><h1>Sürüm geçmişi</h1><p>Önceki metinler korunur. Hangi sürümden sözleşme oluşturacağınızı seçebilirsiniz.</p></div><%= link_to "Şablonu düzenle", edit_template_path(@template), class: "btn btn-primary" %></div>
<section class="panel"><% @versions.each do |version| %><article class="flex flex-wrap items-center justify-between gap-5 border-b border-slate-100 p-6 last:border-0"><div class="min-w-0"><div class="flex items-center gap-3"><span class="badge badge-draft">v<%= version.number %></span><h2 class="break-words font-semibold"><%= version.title %></h2><% if version.id == @template.current_version_id %><span class="text-xs font-semibold text-teal-700">Güncel</span><% end %></div><p class="hint mt-3"><%= display_time(version.created_at) %> · <%= version.variables.size %> değişken alan</p></div><div class="flex flex-wrap gap-2"><%= link_to "Görüntüle", template_path(@template, version_id: version.id), class: "btn btn-secondary" %><%= link_to "Bu sürümden oluştur", new_template_document_path(@template, version_id: version.id), class: "btn btn-plain" %></div></article><% end %></section>
